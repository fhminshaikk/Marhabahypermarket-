rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products & Banners Collections
    match /{document=**} {
      // Allow public read access for storefront visitors
      allow read: if true;
      
      // Restrict create, update, delete operations to authenticated admins
      allow write: if request.auth != null;
    }
  }
}
